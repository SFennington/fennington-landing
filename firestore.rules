rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function hasHouseholdAccess(data) {
      return isSignedIn()
        && (
          ('memberEmails' in data && request.auth.token.email != null && data.memberEmails[request.auth.token.email] == true)
          || ('memberUids' in data && data.memberUids[request.auth.uid] in ['owner', 'member'])
        );
    }

    function isHouseholdMember(householdId) {
      return exists(/databases/$(database)/documents/households/$(householdId))
        && hasHouseholdAccess(get(/databases/$(database)/documents/households/$(householdId)).data);
    }

    match /sites/{siteId} {
      allow read: if resource.data.status == 'live' && resource.data.seoIndexable == true;
      allow write: if isAdmin();
    }

    match /leads/{leadId} {
      allow read, write: if isAdmin();
    }

    match /outreach/{messageId} {
      allow read, write: if isAdmin();
    }

    match /suppressions/{emailHash} {
      allow read, write: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read, write: if isAdmin();
    }

    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;

      match /financialProfiles/{profileId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;

        match /accounts/{recordId} {
          allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }

        match /imports/{recordId} {
          allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }

        match /mappings/{recordId} {
          allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }

        match /transactions/{recordId} {
          allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }

        match /categories/{recordId} {
          allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }

        match /merchantMappings/{recordId} {
          allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }

        match /rules/{recordId} {
          allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }

        match /recurring/{recordId} {
          allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }

        match /settings/{recordId} {
          allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }

        match /overtimeScenarios/{recordId} {
          allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }

        match /monthlySummaries/{recordId} {
          allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
        }
      }
    }

    match /households/{householdId} {
      allow read, update: if hasHouseholdAccess(resource.data) && hasHouseholdAccess(request.resource.data);
      allow create: if hasHouseholdAccess(request.resource.data);
      allow delete: if hasHouseholdAccess(resource.data);

      match /financialProfiles/{profileId} {
        allow read, create, update, delete: if isHouseholdMember(householdId);

        match /accounts/{recordId} {
          allow read, create, update, delete: if isHouseholdMember(householdId);
        }

        match /imports/{recordId} {
          allow read, create, update, delete: if isHouseholdMember(householdId);
        }

        match /mappings/{recordId} {
          allow read, create, update, delete: if isHouseholdMember(householdId);
        }

        match /transactions/{recordId} {
          allow read, create, update, delete: if isHouseholdMember(householdId);
        }

        match /categories/{recordId} {
          allow read, create, update, delete: if isHouseholdMember(householdId);
        }

        match /merchantMappings/{recordId} {
          allow read, create, update, delete: if isHouseholdMember(householdId);
        }

        match /rules/{recordId} {
          allow read, create, update, delete: if isHouseholdMember(householdId);
        }

        match /recurring/{recordId} {
          allow read, create, update, delete: if isHouseholdMember(householdId);
        }

        match /settings/{recordId} {
          allow read, create, update, delete: if isHouseholdMember(householdId);
        }

        match /overtimeScenarios/{recordId} {
          allow read, create, update, delete: if isHouseholdMember(householdId);
        }

        match /monthlySummaries/{recordId} {
          allow read, create, update, delete: if isHouseholdMember(householdId);
        }
      }
    }

    match /stripeEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /digitalProducts/{productId} {
      allow read, write: if isAdmin();
    }

    match /productAssets/{assetId} {
      allow read, write: if isAdmin();
    }

    match /productPromises/{promiseId} {
      allow read, write: if isAdmin();
    }

    match /productTasks/{taskId} {
      allow read, write: if isAdmin();
    }

    match /productApprovals/{approvalId} {
      allow read, write: if isAdmin();
    }

    match /productPackages/{packageId} {
      allow read, write: if isAdmin();
    }

    match /digitalPurchases/{purchaseId} {
      allow read, write: if isAdmin();
    }

    match /downloadTokens/{tokenId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
