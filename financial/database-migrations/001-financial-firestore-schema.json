{
  "name": "001-financial-firestore-schema",
  "database": "Cloud Firestore",
  "description": "User-scoped Fennington Financial collections and indexes for the CSV-first personal finance first draft.",
  "rootCollections": {
    "users/{userId}": {
      "purpose": "Authenticated Fennington user document. Financial records live below this owner-scoped path.",
      "subcollections": {
        "financialProfiles/{profileId}": {
          "fields": ["userId", "name", "confidenceThreshold", "createdAt", "updatedAt"],
          "subcollections": {
            "accounts/{accountId}": ["userId", "name", "institution", "type", "flowRole", "includeInMoneyFlow", "transferMatchingEnabled", "notes", "updatedAt"],
            "imports/{importId}": ["userId", "fileName", "accountId", "count", "duplicateCount", "importedAt", "updatedAt"],
            "mappings/{mappingId}": ["userId", "name", "mapping", "expensesPositive", "createdAt", "updatedAt"],
            "transactions/{transactionId}": ["userId", "accountId", "importId", "date", "description", "merchant", "amount", "category", "type", "flowType", "reportingType", "recognizedMonth", "transferGroupId", "transferPeerTransactionId", "counterpartyAccountId", "transferDirection", "transferStatus", "flowConfidence", "flowReason", "flowSource", "confidence", "source", "reason", "recurringStatus", "needsReview", "flags", "notes", "updatedAt"],
            "categories/{categoryId}": ["userId", "name", "system", "updatedAt"],
            "merchantMappings/{mappingId}": ["userId", "merchant", "category", "createdAt", "updatedAt"],
            "rules/{ruleId}": ["userId", "type", "match", "category", "createdAt", "updatedAt"],
            "recurring/{recurringId}": ["userId", "merchant", "expectedAmount", "averageAmount", "frequency", "expectedNextDate", "lastPaymentDate", "confidence", "category", "status", "flags", "updatedAt"],
            "settings/income": ["userId", "hourlyRate", "normalWeeklyHours", "payFrequency", "typicalNetPaycheck", "expectedMonthlyIncome", "overtimeHours", "overtimeMultiplier", "additionalExpectedIncome", "scenario", "updatedAt"],
            "overtimeScenarios/{scenarioId}": ["userId", "name", "hours", "multiplier", "updatedAt"],
            "monthlySummaries/{summaryId}": ["userId", "month", "actualIncome", "spending", "remaining", "recurring", "reviewCount", "updatedAt"]
          }
        }
      }
    }
  },
  "security": "firestore.rules only permits a signed-in user to read or write records under users/{request.auth.uid}.",
  "indexes": [
    "collectionGroup transactions: userId ASC, date DESC",
    "collectionGroup transactions: userId ASC, category ASC, date DESC",
    "collectionGroup transactions: userId ASC, needsReview ASC, date DESC"
  ]
}
